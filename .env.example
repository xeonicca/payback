# Web and native Firebase clients use the same existing Firebase project.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Required when building iOS: HTTPS origins, without a path or trailing slash.
# API_BASE_URL is the deployed Nuxt server; SITE_URL is the public invitation site.
NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_SITE_URL=

# SERVER ONLY: existing Firebase Admin service-account JSON; never put this in
# any NUXT_PUBLIC_* variable or the native GoogleService-Info.plist.
GOOGLE_APPLICATION_CREDENTIALS=
